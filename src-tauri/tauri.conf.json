{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slate Viewer",
  "version": "../package.json",
  "identifier": "davezap.slateviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "SlateViewer.Markdown",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "publisher": "Dave",
    "copyright": "© 2026 Dave",
    "category": "Productivity",
    "shortDescription": "Markdown viewer and editor",
    "longDescription": "Slate Viewer reads and edits Markdown (.md) files and folders of notes, using the Slate editor.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "compression": "lzma",
        "languages": [
          "English"
        ],
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/slate-viewer.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/slate-viewer.desktop"
      }
    }
  }
}
